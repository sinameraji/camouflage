{
  "name": "camouflage-tui",
  "version": "2.10.2",
  "description": "High-performance terminal renderer for AI agent applications. A React Ink alternative built for streaming, persistence, and replay.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./types": {
      "types": "./src/types.d.ts",
      "import": "./src/types.js"
    }
  },
  "bin": {
    "camouflage-tui": "./bin/camouflage-tui"
  },
  "files": [
    "src/",
    "bin/",
    "scripts/",
    "README.md"
  ],
  "optionalDependencies": {
    "camouflage-tui-darwin-arm64": "2.10.2",
    "camouflage-tui-darwin-x64": "2.10.2",
    "camouflage-tui-linux-arm64": "2.10.2",
    "camouflage-tui-linux-x64": "2.10.2",
    "camouflage-tui-win32-x64": "2.10.2"
  },
  "scripts": {
    "test": "node --test src/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "camouflage",
    "tui",
    "terminal",
    "agent",
    "ai",
    "rendering",
    "ink",
    "cli",
    "llm",
    "streaming"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sinameraji/camouflage.git",
    "directory": "sdk/node"
  },
  "homepage": "https://github.com/sinameraji/camouflage",
  "bugs": "https://github.com/sinameraji/camouflage/issues"
}
